# DuDu Hán Ngữ Full-Stack — cấu hình môi trường mẫu
# Sao chép thành .env và tuỳ chỉnh khi triển khai production.

# Cổng và địa chỉ lắng nghe máy chủ HTTP (API + SPA production)
HOST=127.0.0.1
PORT=3001

# Đường dẫn tệp cơ sở dữ liệu SQLite (mặc định: data/dudu.sqlite)
DUDU_DB_PATH=data/dudu.sqlite

# Khoá bí mật (>= 32 ký tự) dùng mã hoá AES-256-GCM cho Gemini API key của người dùng.
# Nếu bỏ trống khi chạy local, server sẽ tự sinh và lưu ở data/.dudu-secret.
ENCRYPTION_KEY=

# (Tuỳ chọn) Gemini API key dùng chung phía máy chủ cho Gia sư AI & sinh khóa học.
# Không bao giờ bị lộ về trình duyệt.
GEMINI_API_KEY=

# Số ngày duy trì phiên đăng nhập (HttpOnly cookie)
SESSION_TTL_DAYS=30

# Chế độ chạy: development | production
NODE_ENV=development

# Bật true nếu triển khai sau reverse proxy HTTPS để đặt cờ Secure cho cookie & HSTS
COOKIE_SECURE=false

# CHỈ bật true khi triển khai sau reverse proxy tin cậy (Nginx/Caddy/Cloudflare) để đọc X-Forwarded-For
TRUST_PROXY=false

# Giới hạn tối đa số khóa học tùy chỉnh mỗi tài khoản (mặc định: 50)
MAX_COURSES_PER_USER=50

# Tắt log request API (true/false)
DUDU_QUIET_LOGS=false

# (Tuỳ chọn) Danh sách origin cho phép CORS, cách nhau bằng dấu phẩy
CORS_ORIGIN=
